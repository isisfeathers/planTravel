        <mxCell id="r_active" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=ERone;startArrow=ERzeroToOne;dashed=1;strokeColor=#9673a6;" edge="1" parent="1" source="p_active" target="i_1">
