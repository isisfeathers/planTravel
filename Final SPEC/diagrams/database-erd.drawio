        <!-- prompt_templates to itineraries (Dynamic Injection) -->
        <mxCell id="r_pt_i" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="pt_3" target="i_9">
          <mxGeometry relative="1" as="geometry">
