          <mxGeometry x="540" y="80" width="170" height="780" as="geometry" />
        </mxCell>

        <mxCell id="ll_flight" value="機票資料取得服務 (AFS)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="80" width="180" height="780" as="geometry" />
