        <mxCell id="ll_llm" value="OpenAI (gpt-4o JSON Schema)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1070" y="80" width="200" height="780" as="geometry" />
