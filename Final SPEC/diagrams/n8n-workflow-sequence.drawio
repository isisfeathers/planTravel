        <mxCell id="ll_linebot" value="LINE Messaging API" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1350" y="80" width="160" height="780" as="geometry" />
        </mxCell>

        <!-- Message 1 -->
        <mxCell id="m1" value="1. 提交雙層標籤精靈 (INSERT itineraries &amp; jobs, status='queued')" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="150" as="sourcePoint" />
            <mxPoint x="360" y="150" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Message 2 -->
        <mxCell id="m2" value="2. 回傳 itinerary_id, share_token (前端開啟 Realtime 訂閱等待)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="360" y="185" as="sourcePoint" />
            <mxPoint x="130" y="185" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Message 3 -->
        <mxCell id="m3" value="3. Database Webhook (發送 POST 攜帶 ID 與偏好快照)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d79b00;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="360" y="225" as="sourcePoint" />
            <mxPoint x="625" y="225" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Message 4: Quota & Prompt Query -->
        <mxCell id="m4_1" value="4a. 檢查配額 (3次/日, 活躍&lt;=5) &amp; 查詢 prompt_templates" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3ecf8e;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="625" y="260" as="sourcePoint" />
            <mxPoint x="360" y="260" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m4_2" value="回傳 prompt_directives，n8n 依 priority 動態拼裝 Master Prompt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#3ecf8e;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="360" y="295" as="sourcePoint" />
            <mxPoint x="625" y="295" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Parallel Frame -->
        <mxCell id="frame_par" value="平行非同步處理 (Parallel Orchestration)" style="shape=umlFrame;whiteSpace=wrap;html=1;width=250;height=25;fillColor=none;strokeColor=#ff6600;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="325" width="650" height="200" as="geometry" />
        </mxCell>

        <!-- Parallel Message 5a: Call LLM -->
        <mxCell id="m5a" value="5a. 呼叫 LLM (注入動態 Prompt，強制輸出 行程 + 行李清單 Schema)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="625" y="365" as="sourcePoint" />
            <mxPoint x="1170" y="365" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m5a_res" value="回傳符合 JSON Schema 之完整每日行程與打包清單" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#b85450;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1170" y="415" as="sourcePoint" />
            <mxPoint x="625" y="415" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Parallel Message 5b: Call Flight Service -->
        <mxCell id="m5b" value="5b. 查詢起訖機場航班與評分 (Search Orchestrator)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="625" y="455" as="sourcePoint" />
            <mxPoint x="890" y="455" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m5b_res" value="回傳正規化去重後最佳機票組合與 Deep Link (含快取)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#9673a6;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="890" y="495" as="sourcePoint" />
            <mxPoint x="625" y="495" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Message 6: Update Supabase -->
        <mxCell id="m6" value="6. 注入唯一活動 ID，UPDATE itineraries &amp; jobs (status='completed')" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2bb375;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="625" y="555" as="sourcePoint" />
            <mxPoint x="360" y="555" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Message 7: Realtime Broadcast -->
        <mxCell id="m7" value="7. Supabase Realtime 推播 completed 廣播 (前端秒級載入主畫布)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0066cc;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="360" y="605" as="sourcePoint" />
            <mxPoint x="130" y="605" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Message 8: LINE Messaging API Push -->
        <mxCell id="m8" value="8. POST /push 發送 Bubble Flex Message 通知卡片 (含開啟 LIFF 按鈕)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#008f00;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="625" y="660" as="sourcePoint" />
            <mxPoint x="1430" y="660" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Message 9: User receives push notification in LINE Chat -->
        <mxCell id="m9" value="9. 用戶於 LINE 聊天室收到完成提醒卡片 (點擊重開 LIFF)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#008f00;fontSize=11;" edge="1" parent="1">
