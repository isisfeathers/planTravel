# Atrip PDF Worker Service - 運行設定環境變數
PORT=3004

# ==============================================================================
# Frontend Print URL Configuration
# ==============================================================================
# The base URL of Atrip web app (for Puppeteer to visit and render)
ATRIP_APP_URL=https://atrip.app

# ==============================================================================
# Supabase Database & Storage Configuration
# ==============================================================================
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service Role Key is required for bypass Row-Level Security (RLS) to upload to storage
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ==============================================================================
# LINE Messaging API Configuration
# ==============================================================================
# Used to send the final file message to target user's chat window
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
