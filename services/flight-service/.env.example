# Atrip Flight Service - 運行設定環境變數
PORT=3002

# ==============================================================================
# Apify 託管爬蟲平台金鑰
# ==============================================================================
# 若不設定，或設定為 'mock'，AFS 服務會自動進入【高品質模擬資料測試模式】
# 取得真實金鑰後，將其取代下方值即可啟用真實 Apify 雲端抓取服務。
APIFY_API_TOKEN=mock
