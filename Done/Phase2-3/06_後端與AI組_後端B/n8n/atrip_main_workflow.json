      "parameters": {
        "jsCode": "// TRACK2-03 Quota Guard\n// 支援從 Webhook (body) 或 MCP Execute Workflow Trigger (第一層 json 或 query) 接收參數\nconst item = $input.item.json;\nconst data = item.body || item.query || item; \n\nif (!data.userId || !data.itineraryId) {\n  throw new Error('Missing parameters: userId and itineraryId are required.');\n}\n\n// 整理並往後傳遞參數\nreturn [{ \n  json: {\n    userId: data.userId,\n    itineraryId: data.itineraryId,\n    destination: data.destination || '未指定',\n    days: data.days || 1\n  } \n}];"
      },
      "id": "quota-guard",
      "name": "Quota & Secret Guard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        400,
        300
      ]
    },
