        <mxCell id="node_rt_done" value="Realtime 收到 completed 訊號&#xa;即刻平滑更新介面載入畫布" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
