  <diagram id="atrip-user-flow" name="Atrip UI/UX 使用者流程圖">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 頂部標題 -->
        <mxCell id="title_uf" value="Atrip (你的 AI 自由行規劃夥伴) - 端到端使用者體驗流程圖 (User Flow)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#347FA3;strokeColor=#255973;fontColor=#ffffff;fontStyle=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1540" height="40" as="geometry" />
        </mxCell>

        <!-- 1. LINE 入口節點 -->
        <mxCell id="node_start" value="用戶進入 LINE 官方帳號" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="node_rich_menu" value="點擊 Rich Menu 圖文選單&#xa;「Atrip 智慧自由行」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="node_liff" value="開啟 Atrip LIFF Web App&#xa;初始化 LINE SDK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#347FA3;strokeColor=#255973;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="node_auth" value="檢查本地是否已有&#xa;有效 Supabase JWT?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="node_auth_edge" value="呼叫 Edge Function: auth-line&#xa;(驗證 LINE id_token 並簽發 JWT)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="280" y="335" width="220" height="50" as="geometry" />
        </mxCell>

        <!-- 2. 我的行程儀表板 (Dashboard) -->
        <mxCell id="node_dashboard" value="Atrip 我的行程儀表板 (Dashboard / List View)&#xa;- 活躍中 / 即將出發卡片 (標記 ★ 當前關注)&#xa;- 歷史封存行程 (Archived)&#xa;- 頂部常駐「＋ 規劃新旅程」主按鈕" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="460" height="90" as="geometry" />
        </mxCell>

        <!-- 3. 雙層式標籤精靈 (Chip Selector) -->
        <mxCell id="grp_wizard" value="雙層式標籤精靈 (Quick-Choice Chip / Pill Selector)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="570" width="460" height="360" as="geometry" />
        </mxCell>
        <mxCell id="wiz_l1" value="★ 第 1 層：一鍵懶人套版膠囊 (橫向滾動)&#xa;🏆 平台推薦經典[預選點亮] | 🛍️ 都會血拚 | ⚾ 運動賽事" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#347FA3;strokeColor=#255973;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="grp_wizard">
          <mxGeometry x="20" y="35" width="420" height="45" as="geometry" />
        </mxCell>
        <mxCell id="wiz_dest" value="目的地快捷按鈕 (東京/大阪/首爾/曼谷) &amp; 天數日期" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="grp_wizard">
          <mxGeometry x="20" y="90" width="420" height="35" as="geometry" />
        </mxCell>
        <mxCell id="wiz_hotel_transit" value="住宿策略 (連住基地[預設] vs 換宿) | 交通 (大眾捷運[預設] vs 自駕)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="grp_wizard">
          <mxGeometry x="20" y="135" width="420" height="35" as="geometry" />
        </mxCell>
        <mxCell id="wiz_pace" value="步調膠囊 (慢活 2~3 景點[預設] / 適中 / 充實滿檔 5~6 景點)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="grp_wizard">
          <mxGeometry x="20" y="180" width="420" height="35" as="geometry" />
        </mxCell>
        <mxCell id="wiz_tags" value="主題標籤矩陣 (#在地老饕 #米其林 #購物 #運動賽事 #文青古蹟)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="grp_wizard">
          <mxGeometry x="20" y="225" width="420" height="40" as="geometry" />
        </mxCell>
        <mxCell id="wiz_anchor" value="可選：運動賽事/時間錨點備註 (如「週五晚間東京巨蛋棒球賽」)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="grp_wizard">
          <mxGeometry x="20" y="275" width="420" height="30" as="geometry" />
        </mxCell>
        <mxCell id="wiz_submit" value="✨ 懶人用戶 0 點擊直接點按「一鍵開始 AI 規劃」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F97316;strokeColor=#c2410c;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="grp_wizard">
          <mxGeometry x="40" y="315" width="380" height="35" as="geometry" />
        </mxCell>

        <!-- 4. 任務建立與等待 -->
        <mxCell id="node_create" value="寫入 itineraries &amp; itinerary_jobs&#xa;(status: 'queued', 帶入 idempotency_key)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="540" y="600" width="240" height="50" as="geometry" />
