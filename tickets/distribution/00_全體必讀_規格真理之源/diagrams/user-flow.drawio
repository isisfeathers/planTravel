        <mxCell id="node_loading" value="動態等待畫布 (飛機航線微動畫 + 實用 Tips)&#xa;開啟 Supabase Realtime Channel 監聽" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
