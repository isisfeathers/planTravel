        <mxCell id="canv_timeline" value="每日時間軸卡片 (包含捷運出口與路線交通膠囊)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="grp_canvas">
